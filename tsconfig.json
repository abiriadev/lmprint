{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "preserve",
		"jsx": "react-jsx",
		"types": ["chrome", "node", "vite/client"],
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts"]
}
